DEBUG=true
LOG_LEVEL=info
TZ=Asia/Almaty

GRPC_PORT=5050
HTTP_PORT=9090
HTTP_CORS=true

# вход в интерфейс (ADR-019): local — свои учётки; oidc — OpenID-провайдер (подпись проверяется);
# proxy — доверенный шлюз перед zorko (ruto и т.п.), подпись не проверяется
AUTH_MODE=local
# JWT_SECRET — только для local
JWT_SECRET=dev-only-secret-change-me
# oidc и proxy: роль админа в токене ("клиент:роль" или "роль"), путь к ролям и claim логина
# AUTH_ADMIN_ROLE=zorko:admin
# AUTH_ROLES_CLAIM=
# AUTH_USERNAME_CLAIM=
# oidc:
# OIDC_ISSUER=http://localhost:8180/realms/corp
# OIDC_CLIENT_ID=zorko-ui
# OIDC_SCOPES=openid profile email
# OIDC_AUDIENCE=
# proxy ({url} — адрес возврата):
# AUTH_PROXY_LOGIN_URL=http://localhost:8088/_auth/corp/login?redirect={url}
# AUTH_PROXY_REFRESH_URL=http://localhost:8088/_auth/corp/refresh
# AUTH_PROXY_LOGOUT_URL=http://localhost:8088/_auth/corp/logout?redirect={url}

# MCP-сервер для AI-агентов (ADR-020): только чтение, вход — OAuth через страницу согласия интерфейса
# MCP_ENABLED=true
# MCP_PORT=5060
# MCP_PUBLIC_URL=http://localhost:5060
# MCP_OAUTH_ADMIN_URL=http://localhost:8001
# ключ подписи клиентов; пусто — JWT_SECRET (при AUTH_MODE=oidc/proxy обязателен)
# MCP_OAUTH_SECRET=
# MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1
# MCP_OAUTH_ACCESS_TTL=1h
# MCP_OAUTH_REFRESH_TTL=720h

PG_DSN=postgres://zorko:zorko@localhost:54330/zorko?sslmode=disable
CH_DSN=clickhouse://zorko:zorko@localhost:19000/zorko
KAFKA_BROKERS=localhost:19092

INGEST_PORT=8000
INGEST_PUBLIC_URL=http://localhost:8000

ADMIN_PORT=8001
ADMIN_DIR=./admin-ui
ADMIN_API_BASE_URL=http://localhost:9090

# карты исходников (шаг 3); без S3_ENDPOINT карты выключены
S3_ENDPOINT=localhost:19100
S3_SECURE=false
S3_REGION=us-east-1
S3_BUCKET=zorko
S3_ACCESS_KEY=zorko
S3_SECRET_KEY=zorko-secret
